# Copy to .env.local for local development. Do not commit real values.
# Pull real values from Vercel with: vercel env pull --yes

# Auth0 (Auth0 Next.js SDK v4 names)
AUTH0_SECRET=
APP_BASE_URL=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Neon Postgres (provisioned through the Vercel Marketplace)
DATABASE_URL=

# Umami web analytics (optional, server-only, all-or-nothing).
# Leave all three unset to run with analytics off. Setting only some of them
# makes the app fail at startup. These stay commented so the bootstrap key check
# does not treat optional analytics as required.
# UMAMI_SCRIPT_URL=https://analytics.example.com/script.js
# UMAMI_WEBSITE_ID=
# ANALYTICS_HASH_SECRET=
